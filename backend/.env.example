# ==========================================
# StockMind Backend - Environment Variables
# ==========================================

# Project configuration
PROJECT_NAME="StockMind"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL with asyncpg)
# Matches default docker-compose.yml configuration
DATABASE_URL="postgresql+asyncpg://stockmind:stockmindpassword@localhost:5432/stockmind_db"

# JWT Authentication
SECRET_KEY="super_secret_key_for_development_only_please_change"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# External Services
# Gemini AI integration for Purchase Order suggestions & health checks
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Security (CORS)
# If deploying to a server (e.g. AWS EC2), you must add your server's public IP 
# alongside localhost to allow the frontend to communicate with the backend.
CORS_ORIGINS="http://localhost:5173,http://YOUR_EC2_IP:5173"
