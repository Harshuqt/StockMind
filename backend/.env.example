# ==========================================
# StockMind Backend - Environment Variables
# ==========================================

# Project configuration
PROJECT_NAME="StockMind"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/stockmind"

# JWT Authentication
SECRET_KEY="super_secret_key_for_development_only_please_change"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# External Services
# Gemini AI integration for Purchase Order suggestions & health checks
GEMINI_API_KEY="your_google_gemini_api_key_here"
